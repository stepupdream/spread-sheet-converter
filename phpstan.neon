includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - phpstan-baseline.neon

parameters:
    paths:
        - src

    excludePaths:
        - src/SpreadSheetService/GoogleService.php
        - src/DefinitionDocument/Creators/BladeLoader.php

    # Level 10 is the highest level
    level: 9
